<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background"
    android:padding="16dp"
    tools:context=".InstructionsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="חזרה"
            android:textSize="18sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הוראות"
            android:textStyle="bold"
            android:textSize="28sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מטרת המשחק"
                android:layout_gravity="right"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="להיות השחקן הראשון שצובר 55 נקודות"
                android:textSize="17sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="סוגי הקלפים"
                android:layout_gravity="right"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="מלכות (12 קלפים): נמצאות במרכז כשהן 'ישנות' (הפוכות). לכל מלכה ערך נקודות שונה.\n\nמלך: משמש כדי להעיר (לקחת) מלכה אחת מהמרכז.\n\nדרקון: משמש כהגנה בלבד – עוצר את האביר מלגנוב לך מלכה.\n\nקלפי מספרים (1-10): משמשים להחלפת קלפים מהיד כדי לנסות להשיג קלפי פעולה."
                android:textSize="17sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מהלך המשחק"
                android:layout_gravity="right"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="בכל תור, שחקן מבצע פעולה אחת מתוך האפשרויות הבאות, ולאחר מכן משלים קלפים מהקופה כך שתמיד יהיו לו 5 קלפים ביד:\n\n• הערת מלכה (באמצעות מלך): מניחים קלף מלך בערמת הזריקה, ובוחרים מלכה אחת.\n\n• גניבת מלכה (באמצעות אביר): מניחים אביר ובוחרים שחקן אחר שיש לו מלכה.\n\n• הגנה: שימוש בדרקון נגד אביר.\n\n• החלפת קלפי מספרים: בשלוש דרכים (בודד, זוג או תרגיל חשבון)."
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginTop="15dp"
                android:textStyle="italic"
                android:text="הערה: על מנת להחליף קלפי מספרים יש ללחוץ על הכפתור Exercise.\n\nצבע הכפתור מעיד על התור: טורקיז (תורכם), אפור (תור היריב)."
                android:textSize="17sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>









